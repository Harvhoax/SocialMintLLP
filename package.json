{
  "name": "socialmint",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run check:security && next build && node scripts/prepare-netlify.mjs && npm run check:seo && npm run check:netlify && npm run check:media && npm run check:analytics && npm run check:clarity",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:seo": "node scripts/check-seo.mjs",
    "check:security": "node scripts/check-security.cjs",
    "check:netlify": "node scripts/check-netlify.mjs",
    "check:media": "node scripts/check-media.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "check:clarity": "node scripts/check-clarity.mjs"
  },
  "dependencies": {
    "@next/third-parties": "16.4.3",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "gsap": "^3.14.0",
    "lenis": "^1.3.11",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
